    echo رابط الموقع: https://nadeem-h8rz.onrender.com
) else (
    echo [X] فشل الرفع. إذا ظهرت لك نافذة تسجيل الدخول لـ GitHub يرجى الموافقة عليها.
)
echo ==========================================================
echo.
pause
